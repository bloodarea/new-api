# Copy to .env and fill in real values. Never commit .env.
#
# Generate each secret with:
#   openssl rand -hex 32

# PostgreSQL superuser password (internal to the compose network).
POSTGRES_PASSWORD=

# Redis password (internal to the compose network).
REDIS_PASSWORD=

# Signs session cookies. Changing it logs every user out.
SESSION_SECRET=

# Optional: override the proxy used for upstream provider calls.
# Defaults to http://host.docker.internal:7890 when unset.
# Leave empty if the host has direct internet access.
#HTTP_PROXY_URL=
